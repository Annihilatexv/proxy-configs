#!name=本机开发服务回环 (LocalDevVPN 替代)
#!desc=用 include-tun + IP Rewrite reflect 在设备内建立 loopback 隧道，供 StikDebug / SideStore / WrapPin 等连接本机开发者服务（默认 10.7.0.1）。流量不出设备、不经代理节点。
#!author=WorkBuddy
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/f9/0c/c0/f90cc0a7-6cf8-902c-11ce-5e5fa4ea2731/AppIcon-0-1x_U007epad-0-1-85-220-0.png/512x512bb.png
#!category=系统工具
#!system=iOS,iPadOS
#!loon_version=3.5.3(1007)
#!date=2026-11-10

# 图标：LocalDevVPN 官方 App Store 图标，512x512 PNG
# 本地备份为同目录 localdevvpn-icon.png；外链失效时可自行托管后替换 icon 字段
# ---------------------------------------------------------------
# 前置条件：Loon 3.5.3 (Build 1007) 或更高版本，旧版会静默失效
# IP Rewrite 模块只能在插件中声明，主配置写了不生效
# 命中 reflect 的包交换源/目的 IP 后直接回注本机协议栈，
# 不再进入规则、策略、HTTP Rewrite、脚本或 MitM，也不出网
# ---------------------------------------------------------------
# 如需增加虚拟对端地址：在 General 的 include-tun 追加对应 /32，
# 并在 IP Rewrite 段里为每个地址补一行 reflect 动作
# 注意：不要在注释里写配置语法，避免解析器误判为重复声明
# ---------------------------------------------------------------
# 注意：iOS 同时只允许一个 VPN 生效，开启 Loon 时
# LocalDevVPN / StosVPN 会被顶掉，二者不能共存
# ---------------------------------------------------------------

[General]
ipv6-vif = off
include-tun = 10.7.0.1/32

[IP Rewrite]
10.7.0.1 = reflect
